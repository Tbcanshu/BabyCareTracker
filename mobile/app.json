{
  "expo": {
    "name": "Baby Care Tracker",
    "slug": "baby-care-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.babycaretracker.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Baby Care Tracker to access your photos.",
          "cameraPermission": "Allow Baby Care Tracker to use your camera."
        }
      ]
    ]
  }
}